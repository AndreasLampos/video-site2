{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "video-site2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // These paths always reach the Worker: the homepage is built from the database,
    // and the admin area is checked for a valid login before anything is returned.
    "run_worker_first": ["/", "/index.html", "/api/*", "/media/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "video-site-db",
      // Replace with the id printed by: npx wrangler d1 create video-site-db
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "video-site-media" }
  ],
  "vars": {
    // From Cloudflare Zero Trust, see "Going live" in README.md. The admin area stays locked until both are set.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
